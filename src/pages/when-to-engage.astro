---
/**
 * When to Engage — replicates the live page in order: hero → PRE-SALES /
 * POST-SALES routing steps → "Download the Infographic" → four team
 * sections (Sales, Operations, Solutions Architects, Nurture), each with
 * its own Netlify form.
 *
 * The routing graphic is a PRE-SALES / POST-SALES infinity loop with 14
 * numbered steps (see SCRATCH/shots/when-to-engage.png). Step labels and
 * routing below are taken directly from that screenshot. Rebuilt as two
 * columns of step cards rather than the loop graphic itself — each card
 * links to the #sales/#ops/#solutions/#nurture anchor its step routes to
 * on the live site.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import ContactForm from '../components/ContactForm.astro';
import Button from '../components/Button.astro';

const infographicPdf = '/downloads/WHEN-TO-ENGAGE_CTGF_Download.7.17.26-1.pdf';

const teamTags: Record<string, string> = {
  sales: 'Sales',
  ops: 'Operations',
  solutions: 'Solutions',
  nurture: 'Nurture',
};

const preSales = [
  { text: 'Identify gaps, constraints or challenges that need to be addressed', anchor: 'sales' },
  { text: 'Provide a Solution to meet the business requirements', anchor: 'solutions' },
  { text: 'Translate business requirements into IT requirements', anchor: 'solutions' },
  { text: 'Build Solution Quotes and Establish Budgetary Pricing', anchor: 'sales' },
  { text: 'Deliver Solution Builds and Iterate with any modifications', anchor: 'solutions' },
  { text: 'Finalize Pricing', anchor: 'sales' },
  { text: 'Deliver Final Proposal, Quotes and Pricing', anchor: 'sales' },
  { text: 'Process Purchase Order', anchor: 'ops' },
];

const postSales = [
  { text: 'Shipping / Delivery / Tracking', anchor: 'ops' },
  { text: 'Installation / Transition / Migration / Training', anchor: 'solutions' },
  { text: 'Solution Implementation Completion', anchor: 'ops' },
  { text: 'Client Deliverables Completed', anchor: 'nurture' },
  { text: 'Expand / Renew / Repeat', anchor: 'nurture' },
  { text: 'Client Nurture Engagement', anchor: 'nurture' },
];
---

<BaseLayout title="When to Engage - CTG Federal" description="We meet you where you are. Click on your specific need below to be connected with a CTG Federal team member who can help with your specific needs.">
  <PageHero
    eyebrow="When to Engage"
    title="We meet you where you are."
    intro="Click on your specific need below to be connected with a CTG Federal team member who can help with your specific needs."
  />

  <!-- Engagement loop: interactive PRE-SALES / POST-SALES routing -->
  <Section tone="white" id="when-anchor">
    <div class="loop">
      <div class="loop__col">
        <p class="tag">Pre-Sales</p>
        <ol class="loop__list">
          {
            preSales.map((step, i) => (
              <li>
                <a class="loop__step" href={`#${step.anchor}`} data-anchor={step.anchor}>
                  <span class="loop__num">{i + 1}</span>
                  <span class="loop__text">{step.text}</span>
                  <span class="loop__tag">{teamTags[step.anchor]}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="loop__spine" aria-hidden="true">
        <svg class="loop__spine-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 2l4 4-4 4" />
          <path d="M21 6H9a5 5 0 0 0-5 5v1" />
          <path d="M7 22l-4-4 4-4" />
          <path d="M3 18h12a5 5 0 0 0 5-5v-1" />
        </svg>
      </div>

      <div class="loop__col">
        <p class="tag">Post-Sales</p>
        <ol class="loop__list">
          {
            postSales.map((step, i) => (
              <li>
                <a class="loop__step" href={`#${step.anchor}`} data-anchor={step.anchor}>
                  <span class="loop__num">{preSales.length + i + 1}</span>
                  <span class="loop__text">{step.text}</span>
                  <span class="loop__tag">{teamTags[step.anchor]}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
    <p class="loop__hint">Click any step to jump to the team that owns it.</p>
  </Section>

  <script is:inline>
    (function () {
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function highlight(id) {
        var el = document.getElementById(id);
        if (!el) return;
        el.classList.remove('team-section--pulse');
        void el.offsetWidth; // restart animation if the same target is clicked again
        el.classList.add('team-section--pulse');
        window.setTimeout(function () {
          el.classList.remove('team-section--pulse');
        }, 1600);
      }

      function goTo(id, updateHash) {
        var el = document.getElementById(id);
        if (!el) return;
        el.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
        if (updateHash && window.history && window.history.pushState) {
          window.history.pushState(null, '', '#' + id);
        }
        highlight(id);
      }

      var steps = document.querySelectorAll('.loop__step[data-anchor]');
      for (var i = 0; i < steps.length; i++) {
        steps[i].addEventListener('click', function (e) {
          var id = e.currentTarget.getAttribute('data-anchor');
          if (!id) return;
          e.preventDefault();
          goTo(id, true);
        });
      }

      if (window.location.hash) {
        window.setTimeout(function () {
          highlight(window.location.hash.slice(1));
        }, 300);
      }
    })();
  </script>

  <!-- Download infographic -->
  <Section tone="subtle" tight>
    <p class="routes__download">
      <Button href={infographicPdf} external>Download the Infographic</Button>
    </p>
  </Section>

  <!-- SALES -->
  <Section tone="white" id="sales">
    <div class="team">
      <div>
        <h3>Sales</h3>
        <p class="team__email"><a href="mailto:contact@ctgfederal.com">contact@ctgfederal.com</a></p>
      </div>
      <div class="team__form">
        <ContactForm
          name="when-to-engage-sales"
          fields={['name', 'email', 'message']}
          required={['name', 'email']}
          submitLabel="Send"
        />
      </div>
    </div>
  </Section>

  <!-- OPERATIONS -->
  <Section tone="subtle" id="ops">
    <div class="team">
      <div>
        <h3>Operations</h3>
        <p class="team__email"><a href="mailto:operations@ctgfederal.com">operations@ctgfederal.com</a></p>
      </div>
      <div class="team__form">
        <ContactForm
          name="when-to-engage-ops"
          fields={['name', 'email', 'message']}
          required={['name', 'email']}
          submitLabel="Send"
        />
      </div>
    </div>
  </Section>

  <!-- SOLUTIONS ARCHITECTS -->
  <Section tone="white" id="solutions">
    <div class="team">
      <div>
        <h3>Solutions Architects</h3>
        <p class="team__email"><a href="mailto:architects@ctgfederal.com">architects@ctgfederal.com</a></p>
      </div>
      <div class="team__form">
        <ContactForm
          name="when-to-engage-solutions"
          fields={['name', 'email', 'message']}
          required={['name', 'email']}
          submitLabel="Send"
        />
      </div>
    </div>
  </Section>

  <!-- NURTURE -->
  <Section tone="subtle" id="nurture">
    <div class="team">
      <div>
        <h3>Nurture</h3>
        <p class="team__email"><a href="mailto:nurture@ctgfederal.com">nurture@ctgfederal.com</a></p>
      </div>
      <div class="team__form">
        <ContactForm
          name="when-to-engage-nurture"
          fields={['name', 'email', 'message']}
          required={['name', 'email']}
          submitLabel="Send"
        />
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .loop {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: clamp(24px, 4vw, 48px);
  }
  .loop__col .tag {
    text-align: center;
    display: block;
  }
  .loop__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-4);
  }
  .loop__step {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--sp-4);
    padding: var(--sp-5) var(--sp-6);
    text-align: left;
    background: var(--white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition:
      transform var(--dur-med) var(--ease-standard),
      border-color var(--dur-med) var(--ease-standard),
      box-shadow var(--dur-med) var(--ease-standard);
  }
  .loop__step:hover,
  .loop__step:focus-visible {
    border-color: var(--azure);
    box-shadow: 0 10px 24px rgba(0, 37, 80, 0.1);
  }
  .loop__step:focus-visible {
    outline: 2px solid var(--azure);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .loop__step:hover,
    .loop__step:focus-visible {
      transform: translateY(-3px);
    }
  }
  .loop__num {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: none;
    border-radius: var(--radius-sm);
    background: transparent;
    border: 1px solid var(--azure);
    color: var(--navy);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .loop__step:hover .loop__num,
  .loop__step:focus-visible .loop__num {
    background: var(--azure);
    color: var(--white);
  }
  .loop__text {
    font-size: var(--fs-16);
    color: var(--color-fg);
  }
  .loop__tag {
    flex: none;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    background: var(--navy);
    color: var(--white);
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  /* Center spine — evokes the loop without a literal infinity graphic. */
  .loop__spine {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: var(--sp-6);
  }
  .loop__spine::before,
  .loop__spine::after {
    content: '';
    width: 1px;
    flex: 1;
    background: var(--light-gray);
  }
  .loop__spine-icon {
    flex: none;
    width: 40px;
    height: 40px;
    margin-block: var(--sp-4);
    padding: 9px;
    border-radius: 50%;
    border: 1px solid var(--azure);
    color: var(--azure);
    background: var(--white);
  }
  .loop__hint {
    margin: var(--sp-8) 0 0;
    text-align: center;
    font-size: var(--fs-14);
    color: var(--color-fg-muted);
  }
  .routes__download {
    margin: 0;
    text-align: center;
  }
  @media (max-width: 780px) {
    .loop {
      grid-template-columns: 1fr;
    }
    .loop__spine {
      display: none;
    }
    .loop__step {
      grid-template-columns: auto 1fr;
    }
    .loop__tag {
      grid-column: 2;
      justify-self: start;
      margin-top: var(--sp-2);
    }
  }
  .team {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  .team h3 {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .team__email {
    font-size: var(--fs-18);
  }
  @media (max-width: 900px) {
    .team {
      grid-template-columns: 1fr;
    }
  }

  /* Targets rendered by <Section>, not this file, so scoping needs :global(). */
  :global(#sales),
  :global(#ops),
  :global(#solutions),
  :global(#nurture) {
    scroll-margin-top: calc(var(--header-h) + var(--sp-6));
  }
  :global(.team-section--pulse) {
    animation: team-pulse 1.6s var(--ease-standard);
  }
  @keyframes team-pulse {
    0% {
      box-shadow: inset 0 0 0 0 rgba(0, 115, 254, 0.35);
    }
    15% {
      box-shadow: inset 0 0 0 4px rgba(0, 115, 254, 0.35);
    }
    100% {
      box-shadow: inset 0 0 0 0 rgba(0, 115, 254, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.team-section--pulse) {
      animation: none;
    }
  }
</style>
