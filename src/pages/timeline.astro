---
/**
 * Timeline — replicates the live /timeline/ page: intro copy plus the five
 * clickable timeline slide images, presented as a stacked gallery, and the
 * PDF download link.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';

const pdf = '/downloads/CTG-Timeline-7.17.26.pdf';

const slides = [
  { src: '/images/site/1994-2004.png', alt: 'CTG Federal timeline, 1994 to 2004' },
  { src: '/images/site/TimelineSLIDE-2@2x.jpg', alt: 'CTG Federal timeline, 2005 to 2012' },
  { src: '/images/site/2013-2019.png', alt: 'CTG Federal timeline, 2013 to 2019' },
  { src: '/images/site/2020-2024.png', alt: 'CTG Federal timeline, 2020 to 2024' },
  { src: '/images/site/2025-Now.png', alt: 'CTG Federal timeline, 2025 to now' },
];
---

<BaseLayout
  title="CTG Federal Over the Years | Timeline"
  description="In 2017, a team of four talented IT veterans came together to start a forward-thinking company dedicated to delivering best-in-class IT services. The new company would be defined not only by superior technical solutions but by people and partnerships dedicated to transforming and accelerating businesses."
>
  <PageHero
    eyebrow="History"
    title="CTG Over the Years"
    intro="In 2017, a team of four talented IT veterans came together to start a forward-thinking company dedicated to delivering best-in-class IT services. The new company would be defined not only by superior technical solutions but by people and partnerships dedicated to transforming and accelerating businesses. Here’s a bit about our history."
  />

  <Section tone="white">
    <p class="lede timeline-caption">Use the arrows to move through our timeline, one era at a time.</p>

    <div class="timeline-carousel" data-carousel>
      <button class="tcarousel__arrow tcarousel__arrow--prev" type="button" data-prev aria-label="Previous era">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4l-8 8 8 8" /></svg>
      </button>

      <div class="tcarousel__viewport">
        <ul class="tcarousel__track">
          {
            slides.map((slide, i) => (
              <li class="tcarousel__slide" data-slide hidden={i !== 0}>
                <img src={slide.src} alt={slide.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
              </li>
            ))
          }
        </ul>
      </div>

      <button class="tcarousel__arrow tcarousel__arrow--next" type="button" data-next aria-label="Next era">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4l8 8-8 8" /></svg>
      </button>

      <p class="tcarousel__status"><span data-current>1</span> / {slides.length}</p>
    </div>

    <p class="timeline-download">
      <a class="btn btn--primary" href={pdf} target="_blank" rel="noopener">Download the CTG Timeline</a>
    </p>
  </Section>
</BaseLayout>

<style>
  .timeline-caption {
    margin-bottom: var(--sp-8);
  }

  /* One-era-at-a-time carousel with large side arrows. */
  .timeline-carousel {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--sp-3);
    margin: 0 0 var(--sp-8);
  }
  .tcarousel__viewport {
    background: var(--bone);
    border: 1px solid var(--light-gray);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .tcarousel__track {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tcarousel__slide {
    margin: 0;
  }
  .tcarousel__slide img {
    display: block;
    width: 100%;
    height: auto;
  }
  .tcarousel__arrow {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    flex: none;
    background: var(--navy);
    color: var(--white);
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-standard);
  }
  .tcarousel__arrow:hover {
    background: var(--medium);
  }
  .tcarousel__arrow svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tcarousel__status {
    grid-column: 2;
    margin: var(--sp-3) 0 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    font-weight: 500;
    letter-spacing: 0.18em;
    color: var(--medium);
  }
  .timeline-download {
    text-align: center;
  }
  @media (max-width: 560px) {
    .tcarousel__arrow {
      width: 44px;
      height: 44px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const current = root.querySelector<HTMLElement>('[data-current]');
    if (slides.length < 2) return;
    let i = 0;
    const show = (n: number) => {
      slides[i].hidden = true;
      i = (n + slides.length) % slides.length;
      slides[i].hidden = false;
      if (current) current.textContent = String(i + 1);
    };
    root.querySelector<HTMLButtonElement>('[data-prev]')?.addEventListener('click', () => show(i - 1));
    root.querySelector<HTMLButtonElement>('[data-next]')?.addEventListener('click', () => show(i + 1));
  });
</script>
