---
/**
 * Locations — hero, lead copy + interactive office map, office card grid,
 * closing CTA band (map export / location-guide PDF).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import 'leaflet/dist/leaflet.css';

interface Office {
  state: string;
  hq: boolean;
  city: string;
  lat: number;
  lng: number;
  address: string[];
}

const offices: Office[] = [
  {
    state: 'Virginia',
    hq: true,
    city: 'Reston, VA',
    lat: 38.958642,
    lng: -77.358687,
    address: ['1818 Library St.', 'Suite 500', 'Reston, VA 20190'],
  },
  {
    state: 'Tennessee',
    hq: false,
    city: 'Oak Ridge, TN',
    lat: 35.975744,
    lng: -84.234338,
    address: ['1003 Larson Dr.', 'Oak Ridge, TN 37830'],
  },
  {
    state: 'Alabama',
    hq: false,
    city: 'Huntsville, AL',
    lat: 34.696974,
    lng: -86.674129,
    address: ['4100 Market St.', 'Suite 100', 'Huntsville, AL 35808'],
  },
  {
    state: 'New Mexico',
    hq: false,
    city: 'Albuquerque, NM',
    lat: 35.123722,
    lng: -106.606277,
    address: ['3500 Comanche Rd. NE', 'Building A, Suite 1', 'Albuquerque, NM 87107'],
  },
  {
    state: 'California',
    hq: false,
    city: 'San Diego, CA',
    lat: 32.74624,
    lng: -117.196445,
    address: ['4250 Pacific Hwy.', 'Suite 101', 'San Diego, CA 92110'],
  },
];

const mapsHref = (address: string[]) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address.join(', '))}`;

const stateCount = new Set(offices.map((o) => o.state)).size;
---

<BaseLayout
  title="Locations - CTG Federal"
  description="CTG Federal's offices span the DC corridor to the Pacific Coast — find addresses, directions, and an interactive map of our five locations."
>
  <PageHero
    eyebrow="Locations"
    title="CTG Federal is built where our customers are."
    intro="Our account executives, architects, and program teams live and work in states across the country — from the DC corridor to the Pacific Coast."
  />

  <!-- Lead copy + interactive map -->
  <Section tone="white">
    <p class="lede locations-lead">
      That footprint is deliberate. Federal programs don't run on a single time zone, and the
      people who support them shouldn't either. A distributed team means an engineer near the
      installation, a program manager in the customer's meeting, and coverage that doesn't
      depend on a flight; our offices anchor that presence:
    </p>

    <div class="locations-map-wrap">
      <div class="locations-map-meta">
        <p class="locations-stat">{offices.length} Offices &bull; {stateCount} States</p>
        <ul class="locations-legend">
          <li><span class="legend-dot legend-dot--hq"></span>Headquarters</li>
          <li><span class="legend-dot legend-dot--office"></span>Office</li>
        </ul>
      </div>
      <div
        id="locations-map"
        class="locations-map"
        role="img"
        aria-label="Map of CTG Federal's five office locations across the United States"
      >
      </div>
    </div>
  </Section>

  <!-- Office list -->
  <Section tone="subtle">
    <div class="section-heading">
      <h2 class="heading-mono">Our Offices</h2>
      <span class="accent-bar"></span>
    </div>
    <ul class="office-grid">
      {
        offices.map((office) => (
          <li class="office-card">
            <h3 class="office-card__state font-display">
              {office.state}
              {office.hq && ' (HQ)'}
            </h3>
            <address class="office-card__address">
              {office.address.map((line) => (
                <span>{line}</span>
              ))}
            </address>
            <a
              class="office-card__directions"
              href={mapsHref(office.address)}
              target="_blank"
              rel="noopener"
            >
              Get Directions &rarr;
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Closing CTA -->
  <Section tone="white">
    <p class="lede">
      Explore the interactive map to see where our offices are located, or download the
      location guide that also outlines our employee presence within the States to keep on
      hand.
    </p>
    <div class="btn-row">
      <Button
        href="https://ctgfederal.slack.com/files/UNJKCL666/F0BTBCQHA6Q/ctg_office_locations_map.html"
        external
      >
        Explore the Map
      </Button>
      <Button
        href="https://ctgfederal.slack.com/files/UNJKCL666/F0BSSBK6N31/ctg_presence_in_states.pdf"
        variant="outline"
        external
      >
        Download the Location Guide
      </Button>
    </div>
  </Section>

  <script type="application/json" id="offices-data" set:html={JSON.stringify(offices)}></script>
  <script>
    import L from 'leaflet';

    (function () {
      const el = document.getElementById('locations-map');
      if (!el) return;
      const dataEl = document.getElementById('offices-data');
      if (!dataEl) return;
      const offices = JSON.parse(dataEl.textContent);

      const map = L.map(el, {
        center: [38.5, -96.5],
        zoom: 4,
        scrollWheelZoom: false,
        zoomControl: true,
        attributionControl: false,
      });

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18,
      }).addTo(map);

      L.control
        .attribution({ prefix: false })
        .addTo(map)
        .addAttribution(
          '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors'
        );

      // Refined, professional cartography: soften saturation, lift brightness
      // slightly so the Navy/Azure markers hold focus.
      const style = document.createElement('style');
      style.textContent = '.locations-map .leaflet-tile { filter: grayscale(35%) brightness(1.06) contrast(0.94); }';
      document.head.appendChild(style);

      function markerIcon(office) {
        const size = office.hq ? 42 : 28;
        return L.divIcon({
          className: '',
          html:
            '<div class="ctg-marker' +
            (office.hq ? ' ctg-marker--hq' : '') +
            '" style="width:' +
            size +
            'px;height:' +
            size +
            'px">' +
            '<span class="ctg-marker__ring"></span>' +
            '<span class="ctg-marker__ring ctg-marker__ring--2"></span>' +
            '<span class="ctg-marker__dot"></span>' +
            (office.hq ? '<span class="ctg-marker__badge">HQ</span>' : '') +
            '</div>',
          iconSize: [size, size],
          iconAnchor: [size / 2, size / 2],
          popupAnchor: [0, -(size / 2) - 6],
        });
      }

      function popupHtml(office) {
        const q = encodeURIComponent(office.address.join(', '));
        return (
          '<div class="ctg-popup">' +
          '<div class="ctg-popup__header">' +
          '<span class="ctg-popup__state">' +
          office.state +
          '</span>' +
          (office.hq ? '<span class="ctg-popup__badge">Headquarters</span>' : '') +
          '</div>' +
          '<div class="ctg-popup__city">' +
          office.city +
          '</div>' +
          '<div class="ctg-popup__label">Office Address</div>' +
          '<div class="ctg-popup__address">' +
          office.address.join('<br>') +
          '</div>' +
          '<a class="ctg-popup__directions" href="https://www.google.com/maps/search/?api=1&query=' +
          q +
          '" target="_blank" rel="noopener">Get Directions &rarr;</a>' +
          '</div>'
        );
      }

      offices.forEach(function (office) {
        const marker = L.marker([office.lat, office.lng], {
          icon: markerIcon(office),
          zIndexOffset: office.hq ? 1000 : 0,
        }).addTo(map);

        marker.bindTooltip(
          '<span class="ctg-tooltip__city">' +
            office.city +
            '</span><span class="ctg-tooltip__sub">' +
            (office.hq ? 'Headquarters' : 'Office') +
            '</span>',
          { direction: 'top', offset: [0, office.hq ? -26 : -18], className: 'ctg-tooltip' }
        );

        marker.bindPopup(popupHtml(office), {
          closeButton: true,
          autoPanPadding: [30, 30],
          maxWidth: 300,
        });
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') map.closePopup();
      });
    })();
  </script>
</BaseLayout>

<style>
  .locations-lead {
    margin-bottom: var(--sp-8);
  }

  .locations-map-wrap {
    margin-top: var(--sp-2);
  }
  .locations-map-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-bottom: var(--sp-4);
  }
  .locations-stat {
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--azure);
    margin: 0;
  }
  .locations-legend {
    display: flex;
    gap: var(--sp-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .locations-legend li {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--charcoal);
    margin: 0;
  }
  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  .legend-dot--hq {
    background: var(--navy);
    border: 2px solid var(--azure-300);
  }
  .legend-dot--office {
    background: var(--azure);
    border: 2px solid var(--azure-100);
  }

  .locations-map {
    width: 100%;
    height: clamp(360px, 55vh, 560px);
    border-radius: var(--radius-md);
    border: 1px solid var(--light-gray);
    overflow: hidden;
    background: var(--bone);
  }

  .office-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-6);
    list-style: none;
    margin: var(--sp-8) 0 0;
    padding: 0;
  }
  .office-card {
    background: var(--white);
    border: 1px solid var(--light-gray);
    border-radius: var(--radius-md);
    padding: var(--sp-6);
    transition: border-color var(--dur-med) var(--ease-standard);
  }
  .office-card:hover {
    border-color: var(--azure);
  }
  .office-card__state {
    margin: 0 0 var(--sp-3);
    font-size: var(--fs-h2);
  }
  .office-card__address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    color: var(--charcoal);
    font-size: var(--fs-ui);
    line-height: 1.5;
    margin: 0 0 var(--sp-4);
  }
  .office-card__directions {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--fs-ui);
    color: var(--medium);
  }

  @media (max-width: 900px) {
    .office-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .office-grid {
      grid-template-columns: 1fr;
    }
    .locations-map-meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<style is:global>
  /* Leaflet markup is injected client-side and lives outside Astro's
     component scope — these rules must stay global to reach it. */

  .locations-map .leaflet-control-attribution {
    background: rgba(255, 255, 255, 0.85);
    font-family: var(--font-body);
    font-size: 10px;
    color: var(--charcoal);
  }
  .locations-map .leaflet-control-attribution a {
    color: var(--medium);
  }
  .locations-map .leaflet-control-zoom a {
    color: var(--navy);
    border-color: var(--light-gray);
  }
  .locations-map .leaflet-control-zoom a:hover {
    background: var(--bone);
    color: var(--azure);
  }

  /* Markers */
  .ctg-marker {
    position: relative;
  }
  .ctg-marker__ring,
  .ctg-marker__ring--2 {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(0, 115, 254, 0.35);
    animation: ctg-pulse 2.4s ease-out infinite;
  }
  .ctg-marker__ring--2 {
    animation-delay: 1.2s;
  }
  .ctg-marker--hq .ctg-marker__ring,
  .ctg-marker--hq .ctg-marker__ring--2 {
    background: rgba(0, 37, 80, 0.3);
  }
  @keyframes ctg-pulse {
    0% {
      transform: scale(0.5);
      opacity: 0.85;
    }
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  .ctg-marker__dot {
    position: absolute;
    inset: 22%;
    border-radius: 50%;
    background: var(--azure);
    border: 2px solid var(--white);
    box-shadow: 0 0 0 1px rgba(0, 37, 80, 0.25);
  }
  .ctg-marker--hq .ctg-marker__dot {
    background: var(--navy);
    border: 3px solid var(--azure-300);
  }
  .ctg-marker__badge {
    position: absolute;
    top: -9px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--navy);
    color: var(--white);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 1px 5px;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  /* Popup card */
  .leaflet-popup-content-wrapper {
    background: var(--white);
    border: 1px solid var(--light-gray);
    border-radius: var(--radius-md);
    box-shadow: 0 8px 24px rgba(0, 37, 80, 0.12);
    padding: 0;
    overflow: hidden;
  }
  .leaflet-popup-content {
    margin: 0;
    width: 260px !important;
  }
  .leaflet-popup-tip {
    background: var(--white);
    border: 1px solid var(--light-gray);
    box-shadow: none;
  }
  .leaflet-container a.leaflet-popup-close-button {
    color: rgba(255, 255, 255, 0.75);
    padding: 10px 10px 0 0;
  }
  .leaflet-container a.leaflet-popup-close-button:hover {
    color: var(--white);
  }
  .ctg-popup__header {
    background: var(--navy);
    padding: 14px 36px 10px 16px;
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .ctg-popup__state {
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--white);
  }
  .ctg-popup__badge {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--azure);
    color: var(--white);
    padding: 2px 7px;
    border-radius: var(--radius-sm);
  }
  .ctg-popup__city {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--azure-300);
    background: var(--navy);
    padding: 0 16px 12px;
  }
  .ctg-popup__label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--charcoal);
    padding: 14px 16px 4px;
  }
  .ctg-popup__address {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.55;
    color: var(--ink);
    padding: 0 16px;
  }
  .ctg-popup__directions {
    display: inline-block;
    margin: 14px 16px 16px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 12px;
    color: var(--medium);
    border: 1px solid var(--light-gray);
    border-radius: var(--radius-sm);
    padding: 8px 12px;
    text-decoration: none;
  }
  .ctg-popup__directions:hover {
    background: var(--medium);
    color: var(--white);
    border-color: var(--medium);
    text-decoration: none;
  }

  /* Tooltip */
  .ctg-tooltip {
    background: var(--navy);
    color: var(--white);
    border: none;
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 12px;
    padding: 6px 10px;
    box-shadow: 0 4px 12px rgba(0, 37, 80, 0.2);
  }
  .ctg-tooltip::before {
    border-top-color: var(--navy);
  }
  .ctg-tooltip__city {
    display: block;
    font-weight: 700;
  }
  .ctg-tooltip__sub {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--azure-300);
    margin-top: 2px;
  }
</style>
