---
/**
 * Solutions — the /solutions/ hub page. Hero (3-line H1 + six solution tags) →
 * intro paragraph → "Enterprise IT Solutions & Expertise" grid → stats bar →
 * Our Partners → Our Customers → Testimonials.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import StatsBar from '../components/StatsBar.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import LogoGrid from '../components/LogoGrid.astro';
import CustomerLogos from '../components/CustomerLogos.astro';
import Testimonials from '../components/Testimonials.astro';
import HexGrid from '../components/HexGrid.astro';
import { strategic } from '../data/partners';

const lineCardPdf = '/downloads/Line_Card-CTG_Federal_7.20.26.pdf';

/* The live page set these six words inside filled, glowing hexagon PNGs. The
   Brand Standard retires the legacy hexagon graphic (§18A) and bans fills,
   glows and gradients (§18D), so the same six words are now real text in
   registration-marked cells. Wording is unchanged. */
const techTags = [
  'Infrastructure',
  'HPC & AI/ML GenAI',
  'Hybrid Cloud',
  'Cybersecurity',
  'Networking',
  'Communications',
];
---

<BaseLayout
  title="Expert IT Solutions & Engineering Services | CTG Federal"
  description="Information technology expertise, engineering excellence. Best-in-class service. We design and deliver IT solutions that power and equip businesses nationwide."
>
  <!-- Hero -->
  <section class="solhero motif-host">
    <HexGrid corner="tr" size={380} />
    <div class="container solhero__inner">
      <h1 class="solhero__title">
        <span>Information technology expertise.</span>
        <span>Engineering excellence.</span>
        <span>Second-to-none service.</span>
      </h1>
      <ul class="solhero__tags">
        {
          techTags.map((label) => (
            <li>
              <span class="solhero__tag">{label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Intro -->
  <Section tone="white">
    <p class="lede solhero__intro">
      Our experienced team of sales and elite engineering professionals design and deliver IT
      solutions that power and equip businesses nationwide.
    </p>
  </Section>

  <!-- Solutions grid -->
  <Section tone="subtle" id="core-anchor">
    <ServicesGrid heading="Enterprise IT Solutions & Expertise" />
  </Section>

  <!-- Stats -->
  <StatsBar />

  <!-- Partners -->
  <Section tone="white" id="partners">
    <div class="section-heading section-heading--center">
      <h2>Our Partners</h2>
      <span class="accent-bar" />
      <p class="lede">Partnering with best-in-class technology vendors to deliver solutions that enable success.</p>
      <p><a href="/partners/">Learn more about our technology partners</a></p>
    </div>
    <LogoGrid
      logos={strategic}
      cols={6}
      link={{ label: 'See our complete list of partners', href: lineCardPdf, external: true }}
    />
  </Section>

  <!-- Customers -->
  <Section tone="subtle" id="customers">
    <CustomerLogos
      heading="Our Customers"
      intro="We’re trusted by some of the most complex and critical organizations in the nation."
      link={{ label: 'Learn more here', href: '/customers/' }}
    />
  </Section>

  <!-- Testimonials -->
  <Section tone="navy" hex>
    <Testimonials eyebrow="Testimonials" />
  </Section>
</BaseLayout>

<style>
  .solhero {
    position: relative;
    background: var(--navy);
    color: var(--color-on-dark-body);
    padding-block: clamp(56px, 7vw, 96px);
  }
  /* Cover radial — the one permitted gradient in the system. */
  .solhero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: var(--cover-radial);
  }
  .solhero__inner {
    display: grid;
    gap: clamp(32px, 5vw, 56px);
    align-items: center;
    grid-template-columns: 1.2fr 1fr;
  }
  .solhero__title {
    color: var(--white);
    max-width: 22ch;
    margin: 0;
  }
  .solhero__title span {
    display: block;
  }
  .solhero__tags {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-3);
    list-style: none;
    margin: 0 0 0 auto;
    padding: 0;
    max-width: 420px;
  }
  .solhero__tags li {
    margin-bottom: 0;
  }
  .solhero__tag {
    display: flex;
    align-items: center;
    min-height: 64px;
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--azure);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--azure-300);
  }
  .solhero__intro {
    padding-left: var(--sp-6);
    border-left: 3px solid var(--azure);
    max-width: var(--measure);
  }
  @media (max-width: 900px) {
    .solhero__inner {
      grid-template-columns: 1fr;
    }
    .solhero__tags {
      margin-left: 0;
      max-width: 480px;
    }
  }
</style>
