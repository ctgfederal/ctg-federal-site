---
/**
 * ITES-4H — contract detail page: overview, ordering resources, contacts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const overview = [
  { label: 'Contract Number', value: 'W519TC25DA013' },
  { label: 'Socioeconomic Classification', value: 'Small Business' },
  { label: 'NAICS Code', value: '334111' },
  { label: 'Base Ordering Period (POP)', value: '11/20/2025 – 09/18/2030' },
  { label: 'Option Period 1 (if exercised)', value: '09/19/2030 – 09/18/2035' },
  { label: 'Ceiling', value: '$10B' },
  { label: 'Contract Type', value: 'FFP IDIQ' },
];

const benefits = [
  'No Fees associated',
  'Decentralized Ordering',
  'Open to Army, DoD and all Federal Agencies',
  'Orders are Defense Priority (DPAS) Rated: DO-A7',
];

const orderingGuidePdf = '/downloads/E01-Attachment-0002-ITES-4H-Ordering-Guide-03Sep25.pdf';
---

<BaseLayout
  title="ITES-4H | CTG Federal"
  description="Providing the latest in commercial ICT/AV products and services, the NASA SEWP contract vehicle has an outstanding track record of serving up fresh technology for Federal Agencies."
>
  <PageHero eyebrow="Contracts" title="ITES-4H">
    <Breadcrumb light items={[{ label: 'Contracts', href: '/contracts/' }, { label: 'ITES-4H' }]} />
  </PageHero>

  <Section tone="white">
    <div class="intro-row">
      <p class="lede intro-row__text">
        The ITES-4H (Information Technology Enterprise Solutions – 4 Hardware) contract is a U.S. Army
        multiple-award, indefinite delivery/indefinite quantity (IDIQ) vehicle managed by the U.S. Army
        Computer Hardware, Enterprise Software and Solutions (CHESS)/Digital Market (DM), in coordination
        with the Army Contracting Command – Rock Island (ACC-RI). It serves as the fourth generation of the
        Army's IT hardware procurement contracts, following ITES-3H, and is available for use not only by
        the U.S. Army but also by the Department of Defense (DoD) and other federal agencies. ITES-4H
        provides a streamlined, cost-effective way to purchase a wide variety of commercial IT
        equipment—including servers, laptops, tablets, networking gear, storage systems, and
        peripherals—along with related services such as installation, configuration, warranty support, and
        asset tagging. By offering pre-competed, pre-negotiated pricing, the contract accelerates
        procurement timelines and ensures vendors meet rigorous cybersecurity and supply chain risk
        management requirements.
      </p>
      <img class="intro-row__logo" src="/images/site/ITES-4H-logo.png" alt="ITES-4H" width="600" height="505" />
    </div>
  </Section>

  <Section tone="subtle">
    <div class="section-heading">
      <h2>Contract Overview</h2>
      <span class="accent-bar"></span>
    </div>
    <dl class="overview-grid">
      {
        overview.map((row) => (
          <div class="overview-grid__row">
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))
      }
      <div class="overview-grid__row overview-grid__row--full">
        <dt>Benefits of using ITES-4H</dt>
        <dd>
          <ul>
            {benefits.map((b) => <li>{b}</li>)}
          </ul>
        </dd>
      </div>
    </dl>
  </Section>

  <Section tone="white">
    <div class="section-heading">
      <h2>Contract Resources</h2>
      <span class="accent-bar"></span>
    </div>
    <div class="grid grid--3">
      <div class="card">
        <h3>Program Manager (PM)</h3>
        <p>
          Kendra Nelson<br />
          <a href="mailto:contracts@ctgfederal.com">contracts@ctgfederal.com</a><br />
          <a href="tel:720-220-7196">720-220-7196</a>
        </p>
      </div>
      <div class="card">
        <h3>Product Officers/Contract Administrators</h3>
        <p>
          Mitsuko Coulby<br />
          <a href="mailto:mitsuko.j.Coulby.cvi@army.mil">mitsuko.j.Coulby.cvi@army.mil</a>
        </p>
        <p>
          Kathy Spears<br />
          <a href="mailto:Kathleen.l.spears.ctr@army.mil">Kathleen.l.spears.ctr@army.mil</a>
        </p>
      </div>
      <div class="card">
        <h3>Contracting Officer (KO)</h3>
        <p>
          Shelly Hitt<br />
          <a href="mailto:shelly.a.hitt.civ@army.mil">shelly.a.hitt.civ@army.mil</a>
        </p>
      </div>
      <div class="card">
        <h3>Customer Support</h3>
        <p>
          <a href="mailto:ITES-4H@ctgfederal.com">ITES-4H@ctgfederal.com</a><br />
          <a href="tel:703-278-3885">703-278-3885</a><br />
          Ext. 3 for Technical Support<br />
          Ext. 5 for Contracts Support
        </p>
      </div>
      <div class="card">
        <h3>IT e-Mart and Ordering Guide</h3>
        <p>
          <a href="https://chess.army.mil/" target="_blank" rel="noopener">IT e-Mart</a><br />
          <a href={orderingGuidePdf} target="_blank" rel="noopener">Ordering Guide</a>
        </p>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .intro-row {
    display: grid;
    grid-template-columns: 3fr 1fr;
    gap: var(--sp-10);
    align-items: center;
  }
  .intro-row__logo {
    width: 100%;
    max-width: 220px;
    margin-inline: auto;
  }
  @media (max-width: 820px) {
    .intro-row {
      grid-template-columns: 1fr;
    }
    .intro-row__logo {
      max-width: 140px;
    }
  }

  .overview-grid {
    display: grid;
    gap: 0;
    max-width: 900px;
    margin: 0;
  }
  .overview-grid__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-6);
    padding-block: var(--sp-4);
    border-bottom: 1px solid var(--color-border);
  }
  .overview-grid__row dt {
    color: var(--color-fg-muted);
    font-weight: var(--fw-medium);
  }
  .overview-grid__row dd {
    margin: 0;
    color: var(--ctg-navy);
    font-weight: var(--fw-medium);
  }
  .overview-grid__row--full dd ul {
    margin: 0;
    padding-left: 1.1em;
  }
  @media (max-width: 640px) {
    .overview-grid__row {
      grid-template-columns: 1fr;
      gap: var(--sp-1);
    }
  }
</style>
