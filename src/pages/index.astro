---
/**
 * Home — replicates every section of the live home page, in order:
 * hero → About → stats bar → solutions grid → partners → customers →
 * testimonials → procurement options band.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import StatsBar from '../components/StatsBar.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import LogoGrid from '../components/LogoGrid.astro';
import CustomerLogos from '../components/CustomerLogos.astro';
import CtaBand from '../components/CtaBand.astro';
import HexGrid from '../components/HexGrid.astro';
import { strategic } from '../data/partners';

const capabilitiesPdf = '/downloads/CTG_Federal-Overview_Capabilities_Statement_7.20.26-2.pdf';
---

<BaseLayout
  title="IT Solutions for Government Agencies Nationwide | CTG Federal"
  description="Empowering organizations with best-in-class IT. We deliver scalable solutions, reduce risk, and provide nationwide support."
>
  <!-- Hero -->
  <section class="hero motif-host">
    <img class="hero__bg" src="/images/generated/hero-federal.jpg" alt="" width="2400" height="1018" fetchpriority="high" decoding="async" />
    <div class="hero__scrim"></div>
    <HexGrid corner="tr" size={420} />
    <div class="container hero__inner">
      <div class="hero__content">
        <p class="tag hero__tag">Enterprise IT</p>
        <h1 class="hero__title display-xl">
          <span>Equipping agencies</span>
          <span>nationwide to operate</span>
          <span>with velocity and scale</span>
        </h1>
        <p class="hero__actions">
          <a class="btn btn--primary" href={capabilitiesPdf} target="_blank" rel="noopener">Learn More</a>
        </p>
      </div>
    </div>
  </section>

  <!-- About -->
  <Section tone="white">
    <div class="split split--wide-text about">
      <div>
        <p class="tag">{'01\u00A0\u00A0About'}</p>
        <h2>A trusted advisor specializing in smart, secure, and scalable solutions</h2>
        <span class="accent-bar"></span>
      </div>
      <div class="about__body">
        <p>
          CTG Federal, a Cohesive Technology Group company&trade;, is a small business that excels in
          servicing federal defense, intelligence, and civilian organizations with best-in-class
          information technology. Our experienced team of sales and engineering professionals design
          and deliver IT hardware and software solutions that save time and money for our customers.
          Headquartered in Virginia, we have dedicated resources in all regions across the
          continental United States.
        </p>
        <p class="about__more"><a href="/about/">Read more</a></p>
      </div>
    </div>
  </Section>

  <!-- Stats -->
  <StatsBar />

  <!-- Solutions -->
  <Section tone="subtle" id="solutions">
    <ServicesGrid tag={'02\u00A0\u00A0Solutions'} heading="Enterprise IT Solutions & Expertise" />
    <p class="home-cta">
      <a class="btn btn--primary" href="/solutions/">Our Solutions</a>
    </p>
  </Section>

  <!-- Partners -->
  <Section tone="white" id="partners">
    <LogoGrid
      logos={strategic}
      cols={6}
      tag={'03\u00A0\u00A0Partners'}
      heading="Our Partners"
      center={false}
    />
    <p class="home-cta">
      <a class="btn btn--primary" href="/partners/">See all partners</a>
    </p>
  </Section>

  <!-- Customers -->
  <Section tone="subtle" id="customers">
    <CustomerLogos
      tag={'04\u00A0\u00A0Customers'}
      heading="Our Customers"
      center={false}
    />
    <p class="home-cta">
      <a class="btn btn--primary" href="/customers/">Meet our customers</a>
    </p>
  </Section>

  <!-- Procurement options -->
  <CtaBand
    eyebrow={'05\u00A0\u00A0Procurement Options'}
    title="Flexible payment structures designed for our customers’ budget and project needs."
    text="We offer a variety of flexible payment solutions and terms to meet your unique business needs and objectives."
    primary={{ label: 'Contact us', href: '/contacts/' }}
    secondary={{ label: 'Learn more about our procurement options', href: '/procurement-options/' }}
    tone="subtle"
    align="left"
  />
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: clamp(460px, 68vh, 680px);
    overflow: hidden;
    background: var(--navy-900);
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
  }
  /* Left-weighted navy mask: dark enough for the white headline on the left,
     clearing to the right so the flag and Capitol dome stay visible. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(0, 37, 80, 0.85) 0%,
      rgba(0, 37, 80, 0.6) 42%,
      rgba(0, 37, 80, 0.2) 100%
    );
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    padding-block: var(--sp-20);
  }
  /* Headline sits in the image's open left space. */
  .hero__content {
    max-width: 30ch;
    text-align: left;
  }
  /* White, not Azure: the tag sits over photography, where §19B allows
     Azure or White and Azure 300 does not clear AA on the lighter frames. */
  .hero__tag {
    color: var(--white);
  }
  .hero__title {
    /* A touch smaller than the shared display-xl token, hero only. */
    font-size: clamp(28px, 5vw, 56px);
    max-width: none;
    color: var(--white);
    margin: 0 0 var(--sp-8) 0;
  }
  /* One logical line per span; each wraps on its own when space is tight. */
  .hero__title span {
    display: block;
  }
  .hero__actions {
    margin: 0;
  }

  /* ---- About ---- */
  .about__body {
    max-width: 62ch;
  }
  .about__more {
    margin-top: var(--sp-5);
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* ---- Shared ---- */
  /* Prominent per-section CTA button, left-aligned with the section. */
  .home-cta {
    margin: var(--sp-10) 0 0;
  }

  @media (max-width: 820px) {
    .hero__content {
      max-width: 32ch;
    }
  }
</style>
