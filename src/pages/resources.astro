---

<BaseLayout
  title="Resources - CTG Federal"
  description="Quick facts, compliance certifications, and downloadable whitepapers and briefs from CTG Federal."
>
  <PageHero eyebrow="Resources" title="Explore our full library of resources" />

  <Section tone="white">
    <QuickFacts />
  </Section>

  <Section tone="subtle">
    <div class="section-heading">
      <h2 class="heading-mono">WhitePapers & Briefs</h2>
      <span class="accent-bar"></span>
    </div>
    <div class="papers-grid">
      {
        papers.map((paper) => (
          <a class="card card--link paper-card" href={paper.pdf} target="_blank" rel="noopener">
            <img class="paper-card__thumb" src={paper.thumb} alt={`${paper.title} download thumbnail`} loading="lazy" width="400" height="518" />
            <h3>{paper.title}</h3>
            {paper.desc && <p>{paper.desc}</p>}
          </a>
        ))
      }
    </div>
  </Section>

  <Section tone="white">
    <div class="section-heading">
      <h2 class="heading-mono">Videos</h2>
      <span class="accent-bar"></span>
    </div>
    <div class="grid grid--2">
      {
        videos.map((video) => (
          <div class="card video-card">
            <a class="video-card__media" href={video.href} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
              <img class="video-card__thumb" src={video.thumb} alt="" loading="lazy" width="480" height="270" />
            </a>
            <h4>
              <a class="video-card__title" href={video.href} target="_blank" rel="noopener">
                {video.title}
              </a>
            </h4>
            <p>{video.desc}</p>
            <p class="video-card__cta">
              <a href={video.href} target="_blank" rel="noopener">Watch the video</a>
            </p>
          </div>
        ))
      }
    </div>
  </Section>
</BaseLayout>

<style>
  .papers-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-6);
  }
  .paper-card {
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
  }
  .paper-card__thumb {
    width: 100%;
    aspect-ratio: 4 / 5.18;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin-bottom: var(--sp-4);
    border: 1px solid var(--color-border);
  }
  .paper-card h3 {
    font-size: var(--fs-18);
  }
  .paper-card p {
    font-size: var(--fs-14);
    color: var(--color-fg-body);
  }
  @media (max-width: 1024px) {
    .papers-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 820px) {
    .papers-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .papers-grid {
      grid-template-columns: 1fr;
    }
  }

  .video-card__media {
    display: block;
    margin-bottom: var(--sp-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--dur-med) var(--ease-standard);
  }
  .video-card__media:hover {
    border-color: var(--azure);
  }
  .video-card__thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .video-card__title {
    color: var(--navy);
    letter-spacing: inherit;
  }
  .video-card__title:hover {
    color: var(--medium);
  }
  .video-card__cta {
    margin-top: var(--sp-4);
    font-family: var(--font-body);
    font-size: var(--fs-ui);
    font-weight: 700;
    letter-spacing: 0.005em;
  }
  .video-card__cta a {
    color: var(--medium);
  }
  .video-card__cta a:hover {
    color: var(--navy-500);
  }
</style>
