---
/**
 * Warehouse — replicates the live /warehouse/ page: hero, intro copy,
 * "What We Deliver" list, and the Warehouse Capabilities PDF download.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';

const deliverables = [
  'Secure Asset Control',
  'Integration, Staging & Deployment Readiness',
  'Transportation & Deployment',
  'Lifecycle Sustainment & Support',
  'Import, Export & Trade Compliance',
];

const pdf = '/downloads/CTG-Federal-Secure-Warehousing-Integration-Deployment-Services.7.20.26-1.pdf';
---

<BaseLayout
  title="Secure Warehousing, Integration & Deployment - CTG Federal"
  description="Secure warehousing, integration, staging, and deployment services that give federal customers a single source for asset custody, preparation, configuration, and delivery across the full program lifecycle."
>
  <PageHero
    title="Secure Warehousing, Integration & Deployment"
    intro="Our warehousing, integration, staging, and deployment services extend CTG’s role well beyond a traditional value-added reseller. We provide customers with a single source for asset custody, preparation, configuration, and delivery across the full program lifecycle."
  />

  <Section tone="white">
    <div class="split">
      <div>
        <h2>What We Deliver</h2>
        <ul class="prose deliver-list">
          {deliverables.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="warehouse-media">
        <img
          src="/images/generated/warehouse.jpg"
          alt="Secure CTG Federal warehouse with staged IT equipment"
          width="1200"
          height="900"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <div class="warehouse-capabilities">
      <h3 class="h4">Warehouse Capabilities</h3>
      <a class="warehouse-capabilities__link" href={pdf} target="_blank" rel="noopener">
        <img
          src="/images/site/CTG-Federal-Secure-Warehousing-Integration-Deployment-Services.7.20.26-1-pdf.jpg"
          alt="Warehouse Capabilities document preview"
          width="600"
          height="776"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p><a class="btn btn--primary" href={pdf} target="_blank" rel="noopener">Download now</a></p>
    </div>
  </Section>
</BaseLayout>

<style>
  .deliver-list {
    margin-top: var(--sp-5);
  }
  .warehouse-media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }
  .warehouse-capabilities {
    margin-top: var(--sp-16);
    padding-top: var(--sp-16);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }
  .warehouse-capabilities__link {
    display: inline-block;
    margin-top: var(--sp-5);
  }
  .warehouse-capabilities__link img {
    width: 100%;
    max-width: 280px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }
</style>
