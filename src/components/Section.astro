---
/**
 * Section — page rhythm wrapper. One <section> with a container inside.
 *
 *   <Section tone="subtle" id="partners">…</Section>
 *   <Section tone="navy" hex tight>…</Section>
 *   <Section narrow>…</Section>   // 860px prose column
 *
 * tone:   'white' | 'subtle' | 'muted' | 'navy' | 'yale'
 * tight:  60% vertical padding
 * hex:    hex micro-grid corner motif (bottom-left; dark tones only)
 * narrow: narrow container
 * full:   skip the container (child controls its own width)
 */
import HexGrid from './HexGrid.astro';

interface Props {
  tone?: 'white' | 'subtle' | 'muted' | 'navy' | 'yale';
  tight?: boolean;
  hex?: boolean;
  narrow?: boolean;
  full?: boolean;
  id?: string;
  class?: string;
}
const {
  tone = 'white',
  tight = false,
  hex = false,
  narrow = false,
  full = false,
  id,
  class: className = '',
} = Astro.props;

const ground = tone;
const isDark = ground === 'navy' || ground === 'yale';
const showHex = hex && isDark;

const classes = [
  'section',
  ground !== 'white' ? `section--${ground}` : '',
  tight ? 'section--tight' : '',
  showHex ? 'motif-host' : '',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<section class={classes} id={id}>
  {showHex && <HexGrid corner="bl" size={360} />}
  {
    full ? (
      <slot />
    ) : (
      <div class={`container ${narrow ? 'container--narrow' : ''}`.trim()}>
        <slot />
      </div>
    )
  }
</section>
