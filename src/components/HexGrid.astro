---
/**
 * HexGrid — the brand hexagonal micro-grid, as an inline SVG line pattern.
 *
 *   <HexGrid corner="tr" />                 top-right of a hero / cover
 *   <HexGrid corner="bl" size={340} />      bottom-left of a navy divider
 *
 * Brand Standard §18A: 0.5px stroke, Azure, opacity 0.18–0.25, tile 32 × 27.7.
 * Applied as a CORNER MOTIF only — never tiled across a whole surface. The
 * area fades out with a radial mask so it reads as texture, not wallpaper.
 *
 * The parent must be a positioning context: add `.motif-host` (or the legacy
 * `.hex-bg`) to it.
 *
 * corner   'tr' (default) | 'tl' | 'br' | 'bl'
 * size     square edge in px (default 400; brand range is 320–420)
 * opacity  0.18–0.25 (default 0.22)
 * color    stroke color (default Azure)
 */
interface Props {
  corner?: 'tr' | 'tl' | 'br' | 'bl';
  size?: number;
  opacity?: number;
  color?: string;
  class?: string;
}
const {
  corner = 'tr',
  size = 400,
  opacity = 0.22,
  color = '#0073FE',
  class: className = '',
} = Astro.props;

// Unique pattern id so several grids can sit on one page.
const uid = `hex-${Math.random().toString(36).slice(2, 9)}`;

/* Pointy-top hexagon lattice. Circumradius R = 9.2376 → tile 32 × 27.7128.
   Three of the six edges are drawn per cell; neighbours supply the rest, so
   no edge is stroked twice. */
const d = [
  'M-8 -4.6188L0 -9.2376L8 -4.6188L8 4.6188',
  'M8 -4.6188L16 -9.2376L24 -4.6188L24 4.6188',
  'M24 -4.6188L32 -9.2376L40 -4.6188L40 4.6188',
  'M0 9.2376L8 4.6188L16 9.2376L16 18.4752',
  'M16 9.2376L24 4.6188L32 9.2376L32 18.4752',
  'M-8 23.094L0 18.4752L8 23.094L8 32.3316',
  'M8 23.094L16 18.4752L24 23.094L24 32.3316',
  'M24 23.094L32 18.4752L40 23.094L40 32.3316',
].join('');
---

<div
  class={`hexgrid hexgrid--${corner} ${className}`.trim()}
  style={`--hex-size:${size}px; --hex-opacity:${opacity};`}
  aria-hidden="true"
>
  <svg width="100%" height="100%" preserveAspectRatio="xMidYMid slice" focusable="false">
    <defs>
      <pattern id={uid} width="32" height="27.7128" patternUnits="userSpaceOnUse">
        <path d={d} fill="none" stroke={color} stroke-width="0.5" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#${uid})`} />
  </svg>
</div>

<style>
  .hexgrid {
    position: absolute;
    z-index: 0;
    width: var(--hex-size, 400px);
    height: var(--hex-size, 400px);
    max-width: 90%;
    opacity: var(--hex-opacity, 0.22);
    pointer-events: none;
  }
  .hexgrid svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hexgrid--tr {
    top: 0;
    right: 0;
    -webkit-mask-image: radial-gradient(circle at 100% 0%, #000 0%, rgba(0, 0, 0, 0.55) 45%, transparent 72%);
    mask-image: radial-gradient(circle at 100% 0%, #000 0%, rgba(0, 0, 0, 0.55) 45%, transparent 72%);
  }
  .hexgrid--tl {
    top: 0;
    left: 0;
    -webkit-mask-image: radial-gradient(circle at 0% 0%, #000 0%, rgba(0, 0, 0, 0.55) 45%, transparent 72%);
    mask-image: radial-gradient(circle at 0% 0%, #000 0%, rgba(0, 0, 0, 0.55) 45%, transparent 72%);
  }
  .hexgrid--br {
    bottom: 0;
    right: 0;
    -webkit-mask-image: radial-gradient(circle at 100% 100%, #000 0%, rgba(0, 0, 0, 0.55) 45%, transparent 72%);
    mask-image: radial-gradient(circle at 100% 100%, #000 0%, rgba(0, 0, 0, 0.55) 45%, transparent 72%);
  }
  .hexgrid--bl {
    bottom: 0;
    left: 0;
    -webkit-mask-image: radial-gradient(circle at 0% 100%, #000 0%, rgba(0, 0, 0, 0.55) 45%, transparent 72%);
    mask-image: radial-gradient(circle at 0% 100%, #000 0%, rgba(0, 0, 0, 0.55) 45%, transparent 72%);
  }

  @media (max-width: 700px) {
    .hexgrid {
      width: min(var(--hex-size, 400px), 240px);
      height: min(var(--hex-size, 400px), 240px);
    }
  }
</style>
