---
/**
 * Footer — navy site footer. No props; reads src/data/nav.ts and site.ts.
 *
 *   <Footer />
 *
 * Row 1: white logo + parent-company line + accolade badges
 * Row 2: registration IDs, three link columns, contact block
 * Row 3: Fortune license line + copyright / Terms / Privacy
 */
import site from '../data/site';
import { footerColumns } from '../data/nav';

const accolades = [
  {
    src: '/images/site/badge-gptw-certified-2026.png',
    alt: 'Great Place to Work Certified badge',
    href: 'https://www.greatplacetowork.com/certified-company/7020449',
  },
  {
    src: '/images/site/badge-fortune-best-small-workplaces-2025.png',
    alt: 'Fortune Best Small Workplaces 2025 badge',
    href: 'https://www.greatplacetowork.com/best-workplaces/small/2025',
  },
  { src: '/images/site/CTGFederal-ISO-9001-V1.jpg', alt: 'CTG Federal ISO 9001 certification badge' },
  {
    src: '/images/site/badge-crn-tech-elite-250-2026.png',
    alt: 'CRN Tech Elite 250 2026 badge',
    href: 'https://www.crn.com/rankings-and-lists/te2026-details?c=64',
  },
  {
    src: '/images/site/badge-crn-solution-provider-500-2026.png',
    alt: 'CRN Solution Provider 500 2026 badge',
    href: 'https://www.crn.com/sp-500/sp2026-details?c=92',
  },
];

const ids = [
  ['DUNS', site.duns],
  ['UEI', site.uei],
  ['Cage Code', site.cage],
  ['NAICS Primary Code', site.naics],
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-identity">
      <a href="#top" aria-label="Back to top">
        <img src={site.logoFooter} alt="CTG Federal" width="328" height="72" />
      </a>
      <p class="footer-identity__legal">
        a <a href={site.parentUrl} target="_blank" rel="noopener">{site.parentName}</a> company&reg;
      </p>

      <ul class="accolades">
        {
          accolades.map((badge) => (
            <li>
              {badge.href ? (
                <a href={badge.href} target="_blank" rel="noopener">
                  <img src={badge.src} alt={badge.alt} loading="lazy" decoding="async" />
                </a>
              ) : (
                <img src={badge.src} alt={badge.alt} loading="lazy" decoding="async" />
              )}
            </li>
          ))
        }
      </ul>

      <p class="fortune">{site.fortuneLicense}</p>

      <dl class="ids">
        {
          ids.map(([label, value]) => (
            <div class="ids__row">
              <dt>{label}:</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    {
      footerColumns.map((column) => (
        <nav class="footer-col" aria-label="Footer">
          <ul>
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div class="footer-contact">
      <a class="btn btn--outline-light btn--sm footer-contact__cta" href="/contacts/">Contact</a>
      <address>
        <a href={site.address.mapUrl} target="_blank" rel="noopener">
          <img src="/images/icons/location_on_24dp_FILL0_wght400_GRAD0_opsz24.svg" alt="" width="18" height="18" aria-hidden="true" />
          <span>{site.address.full}</span>
        </a>
        <a href={site.phoneHref}>
          <img src="/images/icons/phone_iphone_24dp_FILL0_wght400_GRAD0_opsz24.svg" alt="" width="18" height="18" aria-hidden="true" />
          <span>{site.phone}</span>
        </a>
        <a href={site.emailHref}>
          <img src="/images/icons/mail_24dp_FILL0_wght400_GRAD0_opsz24.svg" alt="" width="18" height="18" aria-hidden="true" />
          <span>{site.email}</span>
        </a>
        <a href={site.linkedin} target="_blank" rel="noopener">
          <img src="/images/icons/linkedin-outline.svg" alt="" width="18" height="18" aria-hidden="true" />
          <span>{site.linkedinLabel}</span>
        </a>
      </address>
    </div>
  </div>

  <div class="container footer-legal">
    <p>
      CTG Federal &copy; {site.copyrightYear} &nbsp;|&nbsp;
      <a href="/terms-and-conditions/">Terms &amp; Conditions</a> &nbsp;|&nbsp;
      <a href="/privacy-policy/">Privacy Policy</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: var(--color-on-dark-body);
    padding-block: var(--sp-16) var(--sp-10);
    font-size: var(--fs-ui);
  }
  .site-footer a {
    color: rgba(255, 255, 255, 0.85);
  }
  .site-footer a:hover {
    color: var(--white);
    text-decoration: none;
  }
  .site-footer li {
    margin-bottom: 0;
  }

  .footer-grid {
    display: grid;
    /* Floors: identity fits the 5-badge row (282px); link columns fit
       "Sustainability" (103px) and "Online Order Status Tool" (180px). */
    grid-template-columns: minmax(292px, 1.5fr) minmax(112px, 1fr) minmax(188px, 1.15fr) 1.25fr;
    gap: clamp(32px, 4vw, 64px);
    align-items: start;
  }

  /* ---- Identity column ---- */
  .footer-identity img {
    width: auto;
    height: 50px;
  }
  .footer-identity__legal {
    margin: var(--sp-3) 0 var(--sp-8);
    font-size: var(--fs-caption);
    letter-spacing: 0.04em;
  }
  .accolades {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--sp-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .accolades img {
    display: block;
    width: auto;
    height: 72px;
    object-fit: contain;
  }
  .fortune {
    margin: var(--sp-6) 0 var(--sp-6);
    font-size: var(--fs-caption);
    line-height: 1.4;
    color: var(--color-on-dark-muted);
    max-width: 46ch;
  }
  .ids {
    margin: 0;
  }
  .ids__row {
    display: flex;
    gap: var(--sp-2);
    margin-bottom: 6px;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.04em;
  }
  .ids dt {
    color: var(--color-on-dark-muted);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .ids dd {
    margin: 0;
    color: var(--azure-300);
    font-variant-numeric: tabular-nums;
  }

  /* ---- Link columns ---- */
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-col li {
    margin-bottom: var(--sp-4);
    line-height: 1.3;
  }
  .footer-col a {
    font-family: var(--font-body);
    font-size: var(--fs-ui);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ---- Contact column ---- */
  .footer-contact__cta {
    margin-bottom: var(--sp-8);
  }
  .footer-contact address {
    display: grid;
    gap: var(--sp-4);
    font-style: normal;
  }
  .footer-contact address a {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: var(--sp-3);
    align-items: start;
    line-height: 1.4;
  }
  .footer-contact address img {
    margin-top: 2px;
    filter: brightness(0) invert(1);
    opacity: 0.6;
  }
  .footer-contact address a:hover img {
    opacity: 1;
  }

  /* ---- Legal ---- */
  .footer-legal {
    margin-top: var(--sp-16);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--color-border-inverse);
    font-size: var(--fs-caption);
    color: var(--color-on-dark-muted);
    text-align: center;
  }

  @media (max-width: 1100px) {
    .footer-grid {
      grid-template-columns: minmax(292px, 1.4fr) 1fr 1fr;
    }
    .footer-contact {
      grid-column: 2 / -1;
    }
  }
  @media (max-width: 1000px) {
    /* Smaller badges need less room, so relax the identity floor and give
       the link columns their width back. */
    .footer-grid {
      grid-template-columns: minmax(260px, 1.4fr) 1fr 1fr;
    }
    .accolades img {
      height: 64px;
    }
  }
  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-10);
    }
    .footer-identity {
      grid-column: 1 / -1;
    }
    .footer-contact {
      grid-column: 1 / -1;
    }
    .accolades img {
      height: 56px;
    }
  }
  @media (max-width: 460px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
