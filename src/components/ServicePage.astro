---
/**
 * ServicePage — shared template for the six solution pages. Reads its
 * copy, images, and capability list from src/data/services.ts by slug.
 *
 *   <ServicePage slug="cybersecurity" />
 *
 * Renders, in the live site's order: PageHero (mono tag + H1 + condensed
 * intro + hero photo) → expanded paragraph + capability grid →
 * Technology Partners (23 strategic logos + line-card PDF) → Our Customers
 * (agency seals) → Testimonials.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from './Section.astro';
import PageHero from './PageHero.astro';
import { getService } from '../data/services';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const service = getService(slug);
if (!service) {
  throw new Error(`ServicePage: unknown service slug "${slug}"`);
}
---

<BaseLayout title={service.seoTitle} description={service.seoDescription} image={service.image}>
  <PageHero eyebrow={service.eyebrow} title={service.title} intro={service.tagline} image={service.image} />

  <Section tone="white" id="solution-anchor">
    <p class="lede service-intro">{service.expanded}</p>
    <ul class="capgrid">
      {
        service.capabilities.map((cap) => (
          <li class="capgrid__item">
            <img src={cap.icon} alt="" width="48" height="48" loading="lazy" decoding="async" />
            <h3 class="capgrid__title">{cap.title}</h3>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>

<style>
  .service-intro {
    max-width: var(--measure);
    margin-bottom: var(--sp-10);
  }
  .capgrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-8) var(--sp-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .capgrid__item {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-4);
    margin-bottom: 0;
  }
  .capgrid__title {
    padding-top: 2px;
  }
  /* The brand's capability PNGs are Azure line art on a white ground, so they
     need no tile and no recolor: on the white section the ground disappears. */
  .capgrid__item img {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    object-fit: contain;
    background: none;
    border: 0;
  }
  .capgrid__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-20);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--navy);
    text-transform: none;
  }
  .service-customers__sub {
    margin-top: var(--sp-2);
  }
  @media (max-width: 900px) {
    .capgrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .capgrid {
      grid-template-columns: 1fr;
    }
  }
</style>
