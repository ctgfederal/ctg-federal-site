---
/**
 * StatsBar — six credibility stats on navy. Reads src/data/stats.ts.
 *
 *   <StatsBar />
 *   <StatsBar tone="yale" />
 *
 * tone: 'navy' (default) | 'yale' | 'gradient'
 */
import { stats } from '../data/stats';

interface Props {
  tone?: 'navy' | 'yale' | 'gradient';
}
const { tone = 'navy' } = Astro.props;
---

<section class={`statsbar statsbar--${tone} hex-bg`}>
  <div class="container">
    <ul class="statsbar__grid">
      {
        stats.map((stat) => (
          <li class="stat">
            <span class="stat__value">{stat.value}</span>
            <span class="stat__label">{stat.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .statsbar {
    background: var(--ctg-navy);
    color: var(--ctg-white);
    padding-block: clamp(40px, 5vw, 64px);
  }
  .statsbar--yale {
    background: var(--ctg-yale-blue);
  }
  .statsbar--gradient {
    background: var(--gradient-brand);
  }
  .statsbar__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--sp-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding-left: var(--sp-4);
    border-left: 2px solid rgba(0, 115, 254, 0.6);
  }
  .stat__value {
    font-family: var(--font-condensed);
    font-weight: var(--fw-medium);
    font-size: clamp(var(--fs-20), 1.9vw, var(--fs-30));
    line-height: 1.08;
    color: var(--ctg-white);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }
  .stat__label {
    font-size: var(--fs-12);
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.66);
  }
  @media (max-width: 1024px) {
    .statsbar__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--sp-8) var(--sp-6);
    }
  }
  @media (max-width: 620px) {
    .statsbar__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
