---
/**
 * StatsBar — six credibility stats on a navy authority band. Reads src/data/stats.ts.
 *
 *   <StatsBar />
 *   <StatsBar tone="yale" />
 *
 * Brand Standard: numbers Georgia, labels JetBrains Mono caps, Azure
 * registration marks at the four corners, hex micro-grid bottom-left.
 *
 * tone: 'navy' (default) | 'yale'
 */
import { stats } from '../data/stats';
import HexGrid from './HexGrid.astro';
import RegMarks from './RegMarks.astro';

interface Props {
  tone?: 'navy' | 'yale';
}
const { tone = 'navy' } = Astro.props;
const ground = tone === 'yale' ? 'yale' : 'navy';
---

<section class={`statsbar statsbar--${ground} motif-host`}>
  <HexGrid corner="bl" size={340} />
  <div class="container">
    <div class="statsbar__frame reg-frame">
      <RegMarks />
      <ul class="statsbar__grid">
        {
          stats.map((stat) => (
            <li class="stat">
              <span class="stat__value">{stat.value}</span>
              <span class="stat__label">{stat.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .statsbar {
    background: var(--navy);
    color: var(--white);
    padding-block: clamp(40px, 5vw, 64px);
  }
  .statsbar--yale {
    background: var(--yale);
  }
  .statsbar__frame {
    position: relative;
    padding: var(--sp-6) var(--sp-8);
  }
  .statsbar__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--sp-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    margin-bottom: 0;
    padding-left: var(--sp-4);
    border-left: 1px solid var(--azure);
  }
  .stat__value {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(22px, 2.1vw, 29px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--white);
    text-wrap: balance;
  }
  .stat__label {
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--azure-300);
  }
  @media (max-width: 1024px) {
    .statsbar__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--sp-8) var(--sp-6);
    }
  }
  @media (max-width: 620px) {
    .statsbar__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .statsbar__frame {
      padding: var(--sp-5) var(--sp-4);
    }
  }
</style>
