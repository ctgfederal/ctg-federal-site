---
/**
 * Breadcrumb — trail above a sub-page title. Last item renders as plain text.
 *
 *   <Breadcrumb items={[{ label: 'Partners', href: '/partners/' }, { label: 'NetApp' }]} />
 *
 * `light` inverts the colors for use on a navy hero.
 */
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
  light?: boolean;
}
const { items, light = false } = Astro.props;
---

<nav class={`crumb ${light ? 'crumb--light' : ''}`.trim()} aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {
      items.map((item) => (
        <li>
          {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    list-style: none;
    margin: 0 0 var(--sp-4);
    padding: 0;
    font-size: var(--fs-14);
    color: var(--color-fg-muted);
  }
  .crumb li + li::before {
    content: '/';
    margin-right: var(--sp-2);
    color: var(--color-border-strong);
  }
  .crumb a {
    color: var(--color-fg-muted);
  }
  .crumb a:hover {
    color: var(--color-accent);
  }
  .crumb--light ol,
  .crumb--light li + li::before {
    color: rgba(255, 255, 255, 0.6);
  }
  .crumb--light a {
    color: rgba(255, 255, 255, 0.8);
  }
  .crumb--light a:hover {
    color: #fff;
  }
</style>
