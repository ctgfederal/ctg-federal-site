---
/**
 * CtaBand — closing band with a heading, optional copy, and up to two buttons.
 *
 *   <CtaBand title="Procurement Options"
 *            text="Flexible payment structures…"
 *            primary={{ label: 'Contact us', href: '/contacts/' }}
 *            secondary={{ label: 'Learn more', href: '/procurement-options/' }} />
 *
 * Brand Standard: Navy authority band, Azure registration marks at the four
 * corners, hex micro-grid bottom-left, buttons white-fill / outline-white.
 *
 * eyebrow    optional mono tag above the title
 * tone       'navy' (default) | 'yale' | 'subtle'
 * align      'center' (default) | 'left'
 * primary / secondary: { label, href, external? }
 */
import HexGrid from './HexGrid.astro';
import RegMarks from './RegMarks.astro';

interface Action {
  label: string;
  href: string;
  external?: boolean;
}
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  primary: Action;
  secondary?: Action;
  tone?: 'navy' | 'yale' | 'subtle';
  align?: 'center' | 'left';
}
const {
  eyebrow,
  title,
  text,
  primary,
  secondary,
  tone = 'navy',
  align = 'center',
} = Astro.props;
const ground = tone;
const dark = ground !== 'subtle';
---

<section class={`ctaband ctaband--${ground} ${dark ? 'motif-host' : ''} ctaband--${align}`}>
  {dark && <HexGrid corner="bl" size={340} />}
  <div class="container">
    <div class="ctaband__inner reg-frame">
      {dark && <RegMarks />}
      <div class="ctaband__body">
        {eyebrow && <p class="tag">{eyebrow}</p>}
        <h2>{title}</h2>
        {text && <p class="lede ctaband__text">{text}</p>}
        <div class="btn-row ctaband__actions">
          <a
            class={`btn ${dark ? 'btn--white' : 'btn--primary'}`}
            href={primary.href}
            target={primary.external ? '_blank' : undefined}
            rel={primary.external ? 'noopener' : undefined}
          >
            {primary.label}
          </a>
          {
            secondary && (
              <a
                class={`btn ${dark ? 'btn--outline-light' : 'btn--outline'}`}
                href={secondary.href}
                target={secondary.external ? '_blank' : undefined}
                rel={secondary.external ? 'noopener' : undefined}
              >
                {secondary.label}
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ctaband {
    padding-block: clamp(56px, 7vw, 96px);
  }
  .ctaband--navy {
    background: var(--navy);
  }
  .ctaband--yale {
    background: var(--yale);
  }
  .ctaband--subtle {
    background: var(--bone);
    border-block: 1px solid var(--light-gray);
  }
  .ctaband__inner {
    position: relative;
  }
  .ctaband__body {
    padding: var(--sp-6) var(--sp-8);
  }
  .ctaband--navy h2,
  .ctaband--yale h2 {
    color: var(--white);
  }
  .ctaband--navy .tag,
  .ctaband--yale .tag {
    color: var(--azure-300);
  }
  .ctaband--navy .ctaband__text,
  .ctaband--yale .ctaband__text {
    color: var(--color-on-dark-body);
  }
  .ctaband--center .ctaband__inner {
    max-width: 800px;
    margin-inline: auto;
  }
  .ctaband--center .ctaband__body {
    text-align: center;
  }
  .ctaband--center .ctaband__actions {
    justify-content: center;
  }
  .ctaband--center .ctaband__text {
    margin-inline: auto;
  }
  .ctaband__text {
    margin-bottom: 0;
  }
  .ctaband__actions {
    margin-top: var(--sp-8);
  }
  @media (max-width: 560px) {
    .ctaband__body {
      padding: var(--sp-5) var(--sp-4);
    }
  }
</style>
