---
/**
 * Testimonials — customer quotes side by side. Reads src/data/testimonials.ts.
 *
 *   <Testimonials eyebrow="Testimonials" />
 *   <Testimonials eyebrow="Raving fans" tone="light" />
 *
 * Brand Standard: callout treatment — 3px Azure left rule, Georgia italic,
 * attribution in mono caps. On navy the callout ground stays transparent.
 *
 * eyebrow  mono tag above the quotes (default 'Testimonials')
 * tone     'dark' (default, for use on navy) | 'light'
 */
import { testimonials } from '../data/testimonials';

interface Props {
  eyebrow?: string;
  tone?: 'dark' | 'light';
}
const { eyebrow = 'Testimonials', tone = 'dark' } = Astro.props;
---

<div class={`quotes quotes--${tone}`}>
  {eyebrow && <p class="tag quotes__eyebrow">{eyebrow}</p>}
  {eyebrow && <span class="accent-bar quotes__bar"></span>}
  <div class="quotes__grid">
    {
      testimonials.map((item) => (
        <figure class="quote-card">
          <blockquote class="quote-card__text">{item.quote}</blockquote>
          <figcaption>&ndash; {item.attribution}</figcaption>
        </figure>
      ))
    }
  </div>
</div>

<style>
  .quotes__eyebrow {
    display: block;
    margin-bottom: var(--sp-4);
  }
  .quotes__bar {
    margin-bottom: var(--sp-8);
  }
  /* On navy grounds the azure bar already reads; on light grounds keep it azure too. */
  .quotes--dark .quotes__bar {
    background: var(--azure-300);
  }
  .quotes__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(32px, 5vw, 64px);
  }
  .quote-card {
    position: relative;
    margin: 0;
    padding: var(--sp-6) var(--sp-6) var(--sp-6) var(--sp-6);
    border-left: 3px solid var(--azure);
  }
  .quote-card__text {
    margin: 0 0 var(--sp-5);
    padding: 0;
    border: 0;
    background: transparent;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(18px, 1.5vw, 22px);
    line-height: 1.45;
  }
  .quote-card figcaption {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: var(--fs-tag);
    font-weight: 500;
    letter-spacing: 0.18em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .quotes--dark .quote-card__text {
    color: var(--white);
  }
  .quotes--dark .quote-card figcaption {
    color: var(--azure-300);
  }
  .quotes--light .quote-card {
    background: var(--bone);
  }
  .quotes--light .quote-card__text {
    color: var(--navy);
  }
  .quotes--light .quote-card figcaption {
    color: var(--medium);
  }
  @media (max-width: 820px) {
    .quotes__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
