---
/**
 * CustomerLogos — the seven agency seals. Reads src/data/customers.ts.
 *
 *   <CustomerLogos heading="Our Customers" link={{ label: 'Learn more here', href: '/customers/' }} />
 *   <CustomerLogos intro={false} />
 *
 * tag      optional mono tag line above the heading
 * heading  optional H2
 * intro    true (default) shows the live-site intro line; pass a string to override, false to hide
 * link     optional { label, href } shown under the seals
 */
import { customers, customersIntro } from '../data/customers';

interface Props {
  tag?: string;
  heading?: string;
  intro?: boolean | string;
  link?: { label: string; href: string };
}
const { tag, heading, intro = true, link } = Astro.props;
const introText = intro === true ? customersIntro : intro === false ? null : intro;
---

<div class="custlogos">
  {
    (tag || heading || introText) && (
      <div class="section-heading section-heading--center">
        {tag && <p class="tag">{tag}</p>}
        {heading && <h2>{heading}</h2>}
        <span class="accent-bar" />
        {introText && <p class="lede">{introText}</p>}
      </div>
    )
  }

  <ul class="custlogos__grid">
    {
      customers.map((customer) => (
        <li>
          <img src={customer.logo} alt={customer.name} loading="lazy" decoding="async" />
        </li>
      ))
    }
  </ul>

  {
    link && (
      <p class="custlogos__link text-center">
        <a href={link.href}>{link.label}</a>
      </p>
    )
  }
</div>

<style>
  .custlogos__grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: var(--sp-6);
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }
  .custlogos__grid li {
    display: grid;
    place-items: center;
    margin-bottom: 0;
  }
  .custlogos__grid img {
    width: 100%;
    max-width: 120px;
    aspect-ratio: 1;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.75;
    transition:
      filter var(--dur-med) var(--ease-standard),
      opacity var(--dur-med) var(--ease-standard);
  }
  .custlogos__grid li:hover img {
    filter: grayscale(0);
    opacity: 1;
  }
  .custlogos__link {
    margin: var(--sp-10) 0 0;
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  @media (max-width: 900px) {
    .custlogos__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--sp-8) var(--sp-6);
    }
  }
  @media (max-width: 520px) {
    .custlogos__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
